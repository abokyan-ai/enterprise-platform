{
  "name": "platform-contracts",
  "projectType": "library",
  "root": "adapters/shared/platform-contracts",
  "sourceRoot": "adapters/shared/platform-contracts/src",
  "tags": ["layer:contracts", "scope:shared", "runtime:universal", "framework:none"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/adapters/shared/platform-contracts",
        "tsConfig": "adapters/shared/platform-contracts/tsconfig.lib.json",
        "packageJson": "adapters/shared/platform-contracts/package.json",
        "main": "adapters/shared/platform-contracts/src/index.ts",
        "assets": []
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "options": {
        "tsConfig": "adapters/shared/platform-contracts/tsconfig.lib.json",
        "outputPath": "tmp/typecheck/platform-contracts",
        "main": "adapters/shared/platform-contracts/src/index.ts"
      }
    }
  }
}
