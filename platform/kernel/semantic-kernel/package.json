{
  "name": "@ecosystem/semantic-kernel",
  "version": "0.1.0",
  "private": true,
  "description": "Semantic Kernel — the zero-dependency foundation of the platform semantic meta-model.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  },
  "keywords": ["platform", "semantic-kernel", "no-deps"]
}
